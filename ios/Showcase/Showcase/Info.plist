<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleLocalizations</key><array><string>en</string><string>fr</string></array>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key><string>$(WL_APP_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key><dict/>
	<key>CFBundleURLTypes</key>
	<array><dict><key>CFBundleURLSchemes</key><array><string>$(WL_DEEP_LINK_SCHEME)</string></array></dict></array>
	<key>UIAppFonts</key>
	<array><string>InstrumentSerif-Regular.ttf</string><string>Geist-Regular.ttf</string></array>
	<key>WLTenant</key><string>$(WL_TENANT)</string>
	<key>WLApiBaseUrl</key><string>$(WL_API_BASE_URL)</string>
	<key>WLEnvironment</key><string>$(WL_ENVIRONMENT)</string>
	<key>WLDeepLinkScheme</key><string>$(WL_DEEP_LINK_SCHEME)</string>
	<key>WLSupportEmail</key><string>$(WL_SUPPORT_EMAIL)</string>
	<key>WLPrivacyPolicyUrl</key><string>$(WL_PRIVACY_POLICY_URL)</string>
	<key>WLTermsUrl</key><string>$(WL_TERMS_URL)</string>
	<key>WLDefaultFeatures</key><string>$(WL_DEFAULT_FEATURES)</string>
</dict>
</plist>
