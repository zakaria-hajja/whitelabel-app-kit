#!/bin/sh
# Refuses pushes to main; runs the quality gate (unit tests + lint) before any other push, and on
# macOS the iOS gate too when the push touches iOS or shared Kotlin code.
set -eu

zero=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed; open a pull request instead" >&2
    exit 1
  fi
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    changed="$changed $(git diff --name-only "$base" "$local_sha")"
  fi
done

root="$(git rev-parse --show-toplevel)"
sh "$root/scripts/check.sh"

if [ "$(uname)" = "Darwin" ] && printf '%s\n' $changed | grep -qE '^(ios/|core/|feature/|apps/[^/]+/shared/|build-logic/|gradle/)'; then
  sh "$root/scripts/check-ios.sh"
fi
