<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Google's consent SDK (UMP) is AdMob's: it needs the app's AdMob app ID or consent fails at
             every launch. The application plugin always sets this placeholder (empty without an ID). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>
</manifest>
