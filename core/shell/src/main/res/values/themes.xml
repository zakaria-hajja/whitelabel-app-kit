<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything. The window theme needs no action bar, and is an AppCompat theme
         because FoundationActivity is an AppCompatActivity (per-app language below Android 13). -->
    <style name="Theme.Foundation" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Launch theme. The colors and icon come from the app's res/. -->
    <style name="Theme.Foundation.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Foundation</item>
    </style>
</resources>
