<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: app data in JsonStore files (filesDir/datastore) is backed up and transferred, so a
    reinstall or a new phone restores it. The session and the signed-in user never leave the device:
    tokens are encrypted with a Keystore key that can't be restored. Keep in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/session.json" />
        <exclude domain="file" path="datastore/user.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/session.json" />
        <exclude domain="file" path="datastore/user.json" />
    </device-transfer>
</data-extraction-rules>
