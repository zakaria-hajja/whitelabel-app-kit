<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11: same rules as data_extraction_rules.xml (which Android 12+ reads instead). -->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <exclude domain="file" path="datastore/session.json" />
    <exclude domain="file" path="datastore/user.json" />
</full-backup-content>
