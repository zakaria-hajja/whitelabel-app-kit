<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- brand.xml overrides resources that :core:designsystem and :core:shell read by name. -->
    <issue id="UnusedResources">
        <ignore regexp="R\.(color|dimen|font)\.brand_" />
    </issue>
    <!-- The app layout (design spec section 3) fixes mipmap-anydpi-v26 for launcher icons (minSdk 26). -->
    <issue id="ObsoleteSdkInt">
        <ignore path="**/src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- allowBackup="false" already disables backup before Android 12; no fullBackupContent needed. -->
    <issue id="DataExtractionRules" severity="ignore" />
</lint>
