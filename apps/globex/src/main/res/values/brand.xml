<?xml version="1.0" encoding="utf-8"?>
<!--
  Globex brand overrides: a blue primary family and square corners. Every role not listed here
  falls back to the design-system defaults in core/designsystem/src/main/res/values/brand.xml.
  Contrast (WCAG AA >= 4.5:1): light on_primary 7.76, on_primary_container 13.28;
  dark on_primary 7.72, on_primary_container 7.23.
-->
<resources>
    <color name="brand_light_primary">#1F4FA3</color>
    <color name="brand_light_on_primary">#FFFFFF</color>
    <color name="brand_light_primary_container">#D9E2FF</color>
    <color name="brand_light_on_primary_container">#001945</color>
    <color name="brand_dark_primary">#B1C5FF</color>
    <color name="brand_dark_on_primary">#002C70</color>
    <color name="brand_dark_primary_container">#00419E</color>
    <color name="brand_dark_on_primary_container">#D9E2FF</color>
    <color name="brand_splash_background">#1F4FA3</color>
    <color name="ic_launcher_background">#1F4FA3</color>
    <dimen name="brand_corner_small">0dp</dimen>
    <dimen name="brand_corner_medium">2dp</dimen>
    <dimen name="brand_corner_large">4dp</dimen>
</resources>
